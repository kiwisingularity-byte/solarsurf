---
// AnimatedWave.astro — Three.js wave background for the hero
// Cyber-surf aesthetic, no mascot, just pure visual vibe
---

<div class="wave-bg" id="wave-bg" aria-hidden="true">
  <canvas id="wave-canvas"></canvas>
  <div class="wave-overlay"></div>
  <div class="wave-scan"></div>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('wave-canvas') as HTMLCanvasElement;
  if (canvas) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
    camera.position.set(0, 4, 8);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x050b15, 0);

    // === Wave geometry ===
    const waveGeometry = new THREE.PlaneGeometry(40, 40, 80, 80);
    const waveMaterial = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uColorA: { value: new THREE.Color(0x00f0ff) },
        uColorB: { value: new THREE.Color(0xff6b1a) },
      },
      vertexShader: `
        uniform float uTime;
        varying float vElevation;
        varying vec3 vPosition;
        void main() {
          vPosition = position;
          vec3 pos = position;
          float elevation = sin(pos.x * 0.5 + uTime * 0.6) * 0.4
                          + sin(pos.y * 0.3 + uTime * 0.4) * 0.3
                          + sin((pos.x + pos.y) * 0.4 + uTime * 0.5) * 0.2;
          pos.z += elevation;
          vElevation = elevation;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
        }
      `,
      fragmentShader: `
        uniform vec3 uColorA;
        uniform vec3 uColorB;
        varying float vElevation;
        varying vec3 vPosition;
        void main() {
          float t = smoothstep(-0.5, 0.8, vElevation);
          vec3 color = mix(uColorA, uColorB, t);
          float alpha = 0.25 + t * 0.3;
          gl_FragColor = vec4(color, alpha);
        }
      `,
      wireframe: true,
      transparent: true,
    });

    const wave = new THREE.Mesh(waveGeometry, waveMaterial);
    wave.rotation.x = -Math.PI / 2.5;
    wave.position.y = -1.5;
    scene.add(wave);

    // === Stars / particles in background ===
    const starGeometry = new THREE.BufferGeometry();
    const starCount = 200;
    const starPositions = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      starPositions[i * 3] = (Math.random() - 0.5) * 50;
      starPositions[i * 3 + 1] = Math.random() * 20 - 5;
      starPositions[i * 3 + 2] = (Math.random() - 0.5) * 30 - 10;
    }
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMaterial = new THREE.PointsMaterial({
      color: 0x00f0ff,
      size: 0.05,
      transparent: true,
      opacity: 0.6,
    });
    const stars = new THREE.Points(starGeometry, starMaterial);
    scene.add(stars);

    // === Resize handler ===
    const resize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (w === 0 || h === 0) return; // skip until laid out
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    };

    // Observe the canvas's parent so we resize when it actually lays out
    const ro = new ResizeObserver(() => resize());
    ro.observe(canvas.parentElement!);

    window.addEventListener('resize', resize);
    // Re-run after fonts/images settle (canvas can resize after layout)
    requestAnimationFrame(() => requestAnimationFrame(resize));
    setTimeout(resize, 100);
    setTimeout(resize, 500);

    // === Animation loop ===
    const clock = new THREE.Clock();
    function animate() {
      const elapsed = clock.getElapsedTime();
      waveMaterial.uniforms.uTime.value = elapsed;
      stars.rotation.y = elapsed * 0.02;
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }
    animate();
  }
</script>

<style>
  .wave-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  #wave-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Dark gradient overlay so text stays readable */
  .wave-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 0%, rgba(5, 11, 21, 0.4) 50%, var(--abyss) 100%),
      linear-gradient(180deg, rgba(5, 11, 21, 0.3) 0%, transparent 30%, transparent 70%, var(--abyss) 100%);
    pointer-events: none;
  }

  /* Subtle horizontal scanline for cyber feel */
  .wave-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, transparent 49%, rgba(0, 240, 255, 0.04) 50%, transparent 51%, transparent 100%);
    background-size: 100% 4px;
    pointer-events: none;
    animation: scan-move 8s linear infinite;
    opacity: 0.5;
  }

  @keyframes scan-move {
    0% { background-position: 0 0; }
    100% { background-position: 0 100%; }
  }
</style>
