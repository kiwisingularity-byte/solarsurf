---
import Layout from '../layouts/Layout.astro';
import AnimatedWave from '../components/AnimatedWave.astro';
import StatBlock from '../components/StatBlock.astro';
---

<Layout title="Solar Surf — The Mount's Surf Repairs · Since 1974">
  <!-- ============================================ -->
  <!-- HERO — animated wave + bold headline        -->
  <!-- ============================================ -->
  <section class="hero">
    <AnimatedWave />
    <div class="hero-content">
      <div class="hero-badges">
        <span class="hero-badge hero-badge--rating">⚡ 5.0 — 23 GOOGLE REVIEWS</span>
        <span class="hero-badge hero-badge--est">EST. 1974 · MOUNT MAUNGANUI</span>
      </div>
      <h1 class="hero-title">
        <span class="line line-1">THE MOUNT'S</span>
        <span class="line line-2">ORIGINAL</span>
        <span class="line line-3">SURF REPAIRS<span class="dot">.</span></span>
      </h1>
      <p class="hero-sub">
        Fast repairs. Quality work. Fair prices.<br>
        20+ years of getting you back in the water.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">→ GET A QUOTE</a>
        <a href="tel:+642****8082" class="btn btn-ghost">📞 027 5888 082</a>
      </div>
      <div class="hero-tape" aria-hidden="true">
        <div class="tape-track">
          <span>FIXED IN A FEW DAYS</span><span>★</span>
          <span>QUALITY WORK</span><span>★</span>
          <span>FAIR PRICES</span><span>★</span>
          <span>NO B.S.</span><span>★</span>
          <span>FIXED IN A FEW DAYS</span><span>★</span>
          <span>QUALITY WORK</span><span>★</span>
          <span>FAIR PRICES</span><span>★</span>
          <span>NO B.S.</span><span>★</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- STAT BLOCK — the numbers don't lie          -->
  <!-- ============================================ -->
  <StatBlock />

  <!-- ============================================ -->
  <!-- SERVICES                                      -->
  <!-- ============================================ -->
  <section class="services" id="services">
    <div class="container">
      <div class="section-head">
        <span class="section-tag">[ 01 ] · SERVICES</span>
        <h2 class="section-title">WHAT WE FIX</h2>
        <p class="section-sub">From small dings to full restorations. We don't do Instagram filters for your board — we do real repairs.</p>
      </div>
      <div class="services-grid">
        <div class="service-card reveal">
          <div class="service-num">01</div>
          <div class="service-icon">🔧</div>
          <h3>Ding Repairs</h3>
          <p>Dings, gauges, punctures, slices — any damage your board's taken, we'll fix it right. Same day available.</p>
          <div class="service-meta">SAME DAY AVAILABLE · MOST COMMON</div>
        </div>
        <div class="service-card reveal">
          <div class="service-num">02</div>
          <div class="service-icon">🌊</div>
          <h3>All Board Types</h3>
          <p>Surfboards, SUPs, fibreglass watercraft. Custom solutions for every board we touch.</p>
          <div class="service-meta">SHORTBOARDS · LONGBOARDS · SUP</div>
        </div>
        <div class="service-card reveal">
          <div class="service-num">03</div>
          <div class="service-icon">🏄‍♂️</div>
          <h3>Re-Finishing</h3>
          <p>Major damage or botched repairs? Or just want your board performing like new? We strip and clean all the old wax and grime from the board, then re-finish it — spray finish, wet and dry sanding — for maximum performance. From $100.</p>
          <div class="service-meta">CLEAN · DE-WAX · SPRAY FINISH · FROM $100</div>
        </div>
        <div class="service-card reveal">
          <div class="service-num">04</div>
          <div class="service-icon">✨</div>
          <h3>Fast Turnaround</h3>
          <p>Repairs done in a few days. We quote before we start — no surprises.</p>
          <div class="service-meta">A FEW DAYS · WE QUOTE FIRST</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- STORY — the legacy                            -->
  <!-- ============================================ -->
  <section class="story" id="story">
    <div class="container story-inner">
      <div class="story-text">
        <span class="section-tag">[ 02 ] · SINCE 1974</span>
        <h2>OUR STORY</h2>
        <div class="story-body">
          <p>We started the Mount's very first surfshop in 1974 — <strong>Solar Surfshop</strong> —</p>
          <p>Today, CJ, with decades of experience, the first person to run a Mount surf school. He's been fixing boards for over 20 years.</p>
          <p>When you bring your board to Solar Surf, you're putting it in the hands of people who live and breathe the Mount surf culture.</p>
        </div>
        <div class="story-tags">
          <span>SOLAR SURFSHOP</span>
          <span>1974 → NOW</span>
          <span>50 YEARS</span>
        </div>
      </div>
      <div class="story-visual">
        <div class="story-frame">
          <img src="/images/cj-working.jpg" alt="CJ working on a surfboard repair" class="story-img" />
        </div>
        <div class="story-stat">
          <div class="story-stat-num">20+</div>
          <div class="story-stat-label">YEARS<br>FIXING BOARDS</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- GALLERY                                       -->
  <!-- ============================================ -->
  <section class="gallery" id="work">
    <div class="container">
      <div class="section-head">
        <span class="section-tag">[ 03 ] · THE WORK</span>
        <h2 class="section-title">OUR WORK</h2>
        <p class="section-sub">Real repairs. Real results.</p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item reveal">
          <img src="/images/before-repair.jpg" alt="Surfboard damaged before repair" />
        </div>
        <div class="gallery-item reveal">
          <img src="/images/after-repair.jpg" alt="Surfboard after repair" />
        </div>
        <div class="gallery-item reveal">
          <img src="/images/workshop-real.jpg" alt="Solar Surf workshop" />
        </div>
        <div class="gallery-item reveal">
          <img src="/images/workshop-boards.jpg" alt="Boards hanging in workshop" />
        </div>
        <div class="gallery-item reveal">
          <img src="/images/board-finished.jpg" alt="Finished surfboard with colour work" />
        </div>
        <div class="gallery-item reveal">
          <img src="/images/board-clean.jpg" alt="Clean repaired surfboard" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- VIDEO                                         -->
  <!-- ============================================ -->
  <section class="video-section" id="video">
    <div class="container">
      <div class="section-head">
        <span class="section-tag">[ 04 ] · WATCH</span>
        <h2 class="section-title">SEE IT IN ACTION</h2>
        <p class="section-sub">Watch a real repair happen. No edits. No filters.</p>
      </div>
      <div class="video-wrap reveal">
        <div class="video-frame">
          <video controls playsinline preload="metadata" poster="/images/workshop-real.jpg">
            <source src="/videos/repair-process.mp4" type="video/mp4" />
            Your browser doesn't support video.
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- REVIEWS                                       -->
  <!-- ============================================ -->
  <section class="reviews" id="reviews">
    <div class="container">
      <div class="section-head">
        <span class="section-tag">[ 05 ] · WORD OF MOUTH</span>
        <h2 class="section-title">WHAT PEOPLE SAY</h2>
        <div class="reviews-rating">
          <span class="stars">★★★★★</span>
          <span class="rating-text"><strong>5.0</strong> · 23 GOOGLE REVIEWS</span>
        </div>
      </div>
      <div class="reviews-grid">
        <div class="review-card reveal">
          <div class="review-quote">"</div>
          <p class="review-text">Dropped my board off at 9am and it was done by 1pm. Fantastic job.</p>
          <span class="review-author">— SEAN COLLINS</span>
        </div>
        <div class="review-card reveal">
          <div class="review-quote">"</div>
          <p class="review-text">Excellent repair without any traces of a repair. They even covered other little scratches with paint.</p>
          <span class="review-author">— FIONN GARTLAN</span>
        </div>
        <div class="review-card reveal">
          <div class="review-quote">"</div>
          <p class="review-text">CJ is super friendly and nothing is a problem. He cleaned up bad epoxy work. The board looks like new again.</p>
          <span class="review-author">— CLOUS</span>
        </div>
        <div class="review-card reveal">
          <div class="review-quote">"</div>
          <p class="review-text">Unreal service, professional repair and 24hr turn around! Don't get that with other ding repairs.</p>
          <span class="review-author">— LEE WILLIAMSON</span>
        </div>
        <div class="review-card reveal">
          <div class="review-quote">"</div>
          <p class="review-text">Awesome service. My longboard looks like new now and stronger. They perfectly matched the colours as well.</p>
          <span class="review-author">— SOL ALMONACID</span>
        </div>
        <div class="review-card reveal">
          <div class="review-quote">"</div>
          <p class="review-text">Speedy, professional and friendly! Dropped it off in the morning and by mid-afternoon I had my board back, looking mint.</p>
          <span class="review-author">— SHIRLEY EWING</span>
        </div>
      </div>
      <a href="https://www.google.com/maps/place/Solar+Surf+Board+Repairs/@-37.6487,176.1625" class="reviews-link" target="_blank" rel="noopener">
        SEE ALL 23 REVIEWS ON GOOGLE →
      </a>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- CTA                                           -->
  <!-- ============================================ -->
  <section class="cta">
    <div class="cta-bg"></div>
    <div class="container cta-inner">
      <span class="section-tag">[ 06 ] · STOP READING. START SURFING.</span>
      <h2>DAMAGED<br>YOUR BOARD<span class="dot">?</span></h2>
      <p>Get it fixed fast by the Mount's most trusted repair team. Same-day available. We quote before we start.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary btn-lg">→ GET A QUOTE</a>
        <a href="tel:+642****8082" class="btn btn-ghost btn-lg">📞 CALL NOW</a>
      </div>
      <div class="cta-info">
        <span>UNIT 8, 21 MACDONALD ST</span>
        <span class="cta-divider">·</span>
        <span>MOUNT MAUNGANUI 3116</span>
        <span class="cta-divider">·</span>
        <span>MON-FRI 09:30-13:00</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════════════════════════════════════ */
  /* SECTION COMMONS                           */
  /* ═══════════════════════════════════════════ */
  .section-head {
    text-align: left;
    margin-bottom: 56px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--midnight);
    position: relative;
  }
  .section-head::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 80px;
    height: 2px;
    background: var(--sun);
    box-shadow: 0 0 12px var(--sun-glow);
  }

  .section-tag {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--cyan);
    letter-spacing: 0.2em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    color: var(--text);
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--text-dim);
    max-width: 600px;
    line-height: 1.6;
  }

  /* Reveal on scroll */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ═══════════════════════════════════════════ */
  /* HERO                                       */
  /* ═══════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(5, 11, 21, 0.1) 0%, rgba(5, 11, 21, 0.3) 60%, rgba(5, 11, 21, 0.7) 100%),
      url('/images/hero-surfing-new.jpg') center 30% / cover no-repeat;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 140px 24px 100px;
    width: 100%;
  }

  .hero-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .hero-badge {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    border: 1px solid;
  }
  .hero-badge--rating {
    background: rgba(255, 107, 26, 0.15);
    border-color: var(--sun);
    color: var(--sun);
    text-shadow: 0 0 8px var(--sun-glow);
  }
  .hero-badge--est {
    background: rgba(0, 240, 255, 0.1);
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .hero-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2.8rem, 9vw, 7rem);
    line-height: 0.95;
    color: var(--text);
    text-transform: uppercase;
    margin-bottom: 32px;
    letter-spacing: -0.03em;
  }

  .hero-title .line { display: block; }
  .hero-title .line-1 {
    color: var(--text-dim);
    font-size: 0.6em;
  }
  .hero-title .line-2 {
    color: var(--sun);
    text-shadow: 0 0 32px var(--sun-glow);
  }
  .hero-title .line-3 {
    color: var(--text);
  }
  .hero-title .line-3 .dot {
    color: var(--cyan);
    text-shadow: 0 0 16px var(--cyan-glow);
  }

  .hero-sub {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--cyan);
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 540px;
    font-weight: 700;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.8), 0 0 24px rgba(0, 0, 0, 0.5);
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 64px;
  }

  .btn {
    display: inline-block;
    padding: 16px 32px;
    border-radius: 4px;
    font-family: 'Archivo Black', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.2s ease;
    cursor: pointer;
    text-align: center;
    border: 2px solid transparent;
  }

  .btn-primary {
    background: var(--sun);
    color: var(--abyss) !important;
    border-color: var(--sun);
    box-shadow: 0 0 0 transparent;
  }
  .btn-primary:hover {
    background: var(--sun-hot);
    border-color: var(--sun-hot);
    color: var(--abyss) !important;
    box-shadow: 0 0 32px var(--sun-glow);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text) !important;
    border-color: var(--cyan);
  }
  .btn-ghost:hover {
    background: rgba(0, 240, 255, 0.1);
    color: var(--cyan) !important;
    border-color: var(--cyan);
    box-shadow: 0 0 16px var(--cyan-glow);
    transform: translateY(-2px);
  }

  .btn-lg {
    padding: 22px 44px;
    font-size: 1.05rem;
  }

  /* Hero scrolling tape */
  .hero-tape {
    border-top: 1px solid var(--midnight);
    border-bottom: 1px solid var(--midnight);
    padding: 16px 0;
    overflow: hidden;
    margin: 0 -24px;
  }
  .tape-track {
    display: flex;
    gap: 32px;
    white-space: nowrap;
    animation: tape-scroll 20s linear infinite;
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.1rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .tape-track span:nth-child(even) {
    color: var(--sun);
  }
  @keyframes tape-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .hero-content { padding: 110px 24px 80px; }
    .btn { padding: 14px 24px; font-size: 0.85rem; }
    .btn-lg { padding: 16px 28px; }
    .hero-actions { margin-bottom: 40px; }
  }

  /* ═══════════════════════════════════════════ */
  /* SERVICES                                   */
  /* ═══════════════════════════════════════════ */
  .services {
    padding: 120px 0;
    background: var(--abyss);
    position: relative;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .service-card {
    position: relative;
    background: linear-gradient(180deg, var(--deep) 0%, var(--abyss) 100%);
    border: 1px solid var(--midnight);
    border-radius: 8px;
    padding: 36px 28px;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  .service-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 2px;
    background: var(--sun);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .service-card:hover {
    border-color: var(--sun);
    transform: translateY(-6px);
  }
  .service-card:hover::before {
    transform: scaleX(1);
  }

  .service-num {
    position: absolute;
    top: 16px;
    right: 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 16px;
    display: inline-block;
    filter: drop-shadow(0 0 8px var(--sun-glow));
  }

  .service-card h3 {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .service-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .service-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--cyan);
    letter-spacing: 0.1em;
    padding-top: 16px;
    border-top: 1px solid var(--midnight);
  }

  @media (max-width: 1000px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  /* ═══════════════════════════════════════════ */
  /* STORY                                       */
  /* ═══════════════════════════════════════════ */
  .story {
    padding: 120px 0;
    background: linear-gradient(180deg, var(--abyss) 0%, var(--deep) 50%, var(--abyss) 100%);
    position: relative;
  }

  .story-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .story-text h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    color: var(--text);
    margin-bottom: 32px;
    line-height: 1;
  }

  .story-body p {
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 16px;
  }
  .story-body strong { color: var(--sun); }

  .story-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .story-tags span {
    padding: 6px 14px;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    border-radius: 2px;
  }

  .story-visual {
    position: relative;
  }

  .story-frame {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--midnight);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 480px;
    display: block;
    transition: transform 0.4s;
  }
  .story-frame:hover .story-img { transform: scale(1.03); }

  .story-stat {
    position: absolute;
    bottom: -32px;
    left: -32px;
    background: var(--sun);
    color: var(--abyss);
    padding: 24px;
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(255, 107, 26, 0.3);
    text-align: center;
  }
  .story-stat-num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 2.8rem;
    line-height: 1;
  }
  .story-stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    margin-top: 4px;
  }

  @media (max-width: 900px) {
    .story-inner { grid-template-columns: 1fr; gap: 56px; }
    .story-img { min-height: 320px; }
  }

  /* ═══════════════════════════════════════════ */
  /* GALLERY                                     */
  /* ═══════════════════════════════════════════ */
  .gallery {
    padding: 120px 0;
    background: var(--abyss);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gallery-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4/3;
    border: 1px solid var(--midnight);
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.3s;
  }
  .gallery-item:hover img {
    transform: scale(1.05);
    filter: brightness(1.1);
  }

  .gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 107, 26, 0) 0%, rgba(0, 0, 0, 0.5) 100%);
    pointer-events: none;
  }

  .gallery-label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: var(--abyss);
    color: var(--sun);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    padding: 6px 12px;
    border-radius: 2px;
    border: 1px solid var(--sun);
    z-index: 2;
  }

  @media (max-width: 800px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ═══════════════════════════════════════════ */
  /* VIDEO                                       */
